# Groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Project
COCO_MAX_HISTORY_MESSAGES=12
COCO_MAX_REPLY_TOKENS=250

# Audio
COCO_ENABLE_TTS=true
COCO_ENABLE_MICROPHONE=true

# Local model paths
COCO_PIPER_MODEL=models/piper/en_US-amy-medium.onnx
COCO_VOSK_MODEL=models/vosk/vosk-model-small-en-us-0.15

# Voice input
COCO_MIC_SAMPLE_RATE=16000
COCO_MIC_MAX_SECONDS=15
COCO_MIC_END_SILENCE_SECONDS=1.5